{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "editor815.baikalnews.com"
        }
      ],
      "destination": "/admin/:path*"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": { "pre": "facebookexternalhit" } }
      ],
      "destination": "/api/article-og"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": { "pre": "Twitterbot" } }
      ],
      "destination": "/api/article-og"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": { "pre": "Slackbot" } }
      ],
      "destination": "/api/article-og"
    },
    {
      "source": "/article.html",
      "destination": "/article-app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/generate-daily-briefing",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/send-kakao-briefing",
      "schedule": "15 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
