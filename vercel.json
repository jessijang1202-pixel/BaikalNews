{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "editor815.baikalnews.com"
        }
      ],
      "destination": "/admin/:path*"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": { "pre": "facebookexternalhit" } }
      ],
      "destination": "/api/public-render?type=article"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": { "pre": "Twitterbot" } }
      ],
      "destination": "/api/public-render?type=article"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": { "pre": "Slackbot" } }
      ],
      "destination": "/api/public-render?type=article"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Googlebot.*" }
      ],
      "destination": "/api/public-render?type=article"
    },
    {
      "source": "/article.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Mediapartners-Google.*" }
      ],
      "destination": "/api/public-render?type=article"
    },
    {
      "source": "/article.html",
      "destination": "/article-app.html"
    },
    {
      "source": "/category.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Googlebot.*" }
      ],
      "destination": "/api/public-render?type=category"
    },
    {
      "source": "/category.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Mediapartners-Google.*" }
      ],
      "destination": "/api/public-render?type=category"
    },
    {
      "source": "/category.html",
      "destination": "/category-app.html"
    },
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Googlebot.*" }
      ],
      "destination": "/api/public-render?type=home"
    },
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Mediapartners-Google.*" }
      ],
      "destination": "/api/public-render?type=home"
    },
    {
      "source": "/",
      "destination": "/home-app.html"
    },
    {
      "source": "/index.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Googlebot.*" }
      ],
      "destination": "/api/public-render?type=home"
    },
    {
      "source": "/index.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*Mediapartners-Google.*" }
      ],
      "destination": "/api/public-render?type=home"
    },
    {
      "source": "/index.html",
      "destination": "/home-app.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/public-render?type=sitemap"
    }
  ],
  "functions": {
    "api/gemini-text-proxy.js": { "maxDuration": 60 },
    "api/gemini-image-proxy.js": { "maxDuration": 60 },
    "api/gemini-video-proxy.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
